{
  "name": "eggtart-game",
  "description": "A Phaser 4 + TypeScript + Vite game boilerplate.",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "vite build --config vite/config.prod.mjs",
    "preview": "vite preview --config vite/config.prod.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "phaser": "^4.2.0"
  },
  "devDependencies": {
    "terser": "^5.39.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.1"
  }
}
